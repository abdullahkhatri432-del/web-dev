# ============================================================
# WebForge — environment variables
# Copy this file to `.env.local` and fill in your values.
# NEVER commit `.env.local`.
# ============================================================

# ---- Firebase Web config (CLIENT-SIDE — REQUIRED) ----
# Get these from Firebase Console → Project settings → Your apps
# → Web app → "SDK setup and configuration"
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin SDK (SERVER-SIDE — optional for now) ----
# Project settings → Service accounts → "Generate new private key",
# then base64-encode the downloaded JSON and paste it here:
#   PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccount.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=
